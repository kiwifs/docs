              "quickstart",
              "configuration"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/files-as-truth",
              "concepts/agent-interface",
              "concepts/search",
              "concepts/versioning",
              "concepts/mcp"
            ]
          },
          {
            "group": "Data Import",
            "pages": [
              "import/overview",
              "import/databases",
              "import/files",
              "import/saas"
            ]
          },
          {
            "group": "Data Export",
            "pages": [
              "export/overview"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "deploy/docker",
              "deploy/kubernetes",
              "deploy/go-embed"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "REST API",
            "pages": [
              "api/overview",
              "api/files",
              "api/search",
              "api/versioning",
              "api/metadata",
              "api/import-export",
              "api/analytics"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/commands"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kiwifs/kiwifs",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/kiwifs/kiwifs"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kiwifs"
    }
  }
