{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "KiwiFS — Markdown filesystem for agents and teams",
  "colors": {
    "primary": "#6cbe45",
    "light": "#7dd356",
    "dark": "#4a8a2a"
  },
  "favicon": "/logo/kiwifs.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://github.com/kiwifs/kiwifs"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "search": {
    "prompt": "Search KiwiFS docs..."
  },
  "ai": {
    "enabled": false
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.kiwifs.com"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "configuration"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/files-as-truth",
              "concepts/agent-interface",
              "concepts/search",
              "concepts/versioning",
              "concepts/dql",
              "concepts/wiki-links",
              "concepts/mcp",
              "concepts/webhooks",
              "concepts/schemas"
            ]
          },
          {
            "group": "Data Import",
            "pages": [
              "import/overview",
              "import/databases",
              "import/files",
              "import/saas"
            ]
          },
          {
            "group": "Data Export",
            "pages": [
              "export/overview"
            ]
          },
          {
            "group": "Deployment",
            "pages": [
              "deploy/docker",
              "deploy/kubernetes",
              "deploy/go-embed"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "REST API",
            "pages": [
              "api/overview",
              "api/files",
              "api/search",
              "api/versioning",
              "api/metadata",
              "api/import-export",
              "api/analytics",
              "api/webhooks",
              "api/schemas",
              "api/velocity"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/commands"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kiwifs/kiwifs",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/kiwifs/kiwifs",
        "type": "github"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kiwifs"
    }
  }
}
